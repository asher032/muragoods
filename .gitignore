# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# YouTube cookie jars — live session credentials, NEVER commit
YT_COOKIES_FILE.txt
cookies.txt
*cookies*.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Local service credentials - never commit
service.json

# Python bytecode. These are build artefacts, they are not reviewable, and a
# compiled .pyc can contain a connection string that the .py it came from no
# longer has (for example a URI that was removed from source but not
# regenerated locally). Never commit them.
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Any local env file, in any directory (not just the repo root).
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Temporary compile harness for the playback runtime suite. It is written into
# the repo root (so its relative imports of the real modules resolve) and must
# never be committed.
.playback-harness-*
